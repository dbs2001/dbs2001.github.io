---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
const year = new Date().getFullYear();
const footerLinks = [
  { name: 'How We Help', url: '/#services' },
  { name: 'Training', url: '/#training' },
  { name: 'Insights', url: '/blog/' },
  { name: 'About', url: '/about/' },
  { name: 'RSS', url: '/rss.xml' },
];
---

<footer class="bg-light dark:bg-darkmode-light">
  <div class="container">
    <div class="row items-center py-10">
      <div class="mb-8 text-center lg:col-3 lg:mb-0 lg:text-left">
        <a href="/" class="navbar-brand inline-block">DataSaaz</a>
        <p class="mt-3 text-sm text-text-light dark:text-darkmode-text-light">Engineering AI adoption into everyday practice.</p>
      </div>

      <div class="mb-8 text-center lg:col-6 lg:mb-0">
        <ul>
          {footerLinks.map((item) => (
            <li class="m-3 inline-block"><a href={item.url}>{item.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="mb-8 text-center lg:col-3 lg:mb-0 lg:mt-0 lg:text-right">
        <ul class="social-icons">
          {GITHUB_URL && (
            <li>
              <a href={GITHUB_URL} target="_blank" rel="me noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .7A11.5 11.5 0 0 0 8.36 23.1c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.43-2.71 5.4-5.29 5.69.42.36.79 1.06.79 2.14v3.27c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
              </a>
            </li>
          )}
          {LINKEDIN_URL && (
            <li>
              <a href={LINKEDIN_URL} target="_blank" rel="me noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5.3 7.9H1.7V22h3.6V7.9ZM3.5 2A2.1 2.1 0 1 0 3.5 6.2 2.1 2.1 0 0 0 3.5 2ZM22.3 13.9c0-4.3-2.3-6.3-5.4-6.3-2.5 0-3.6 1.4-4.2 2.3v-2H9.1V22h3.6v-7c0-1.8.4-3.6 2.7-3.6 2.3 0 2.3 2.1 2.3 3.7V22h3.6l1-8.1Z"/></svg>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-border py-7 dark:border-darkmode-border">
    <div class="container text-center text-text-light dark:text-darkmode-text-light">
      <p>
        © {year} DataSaaz. Practical engineering, advisory and training for AI-enabled software teams.
      </p>
    </div>
  </div>
</footer>
