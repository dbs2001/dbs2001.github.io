---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/main.css';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-name" content="astroplate" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL('/rss.xml', Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;600&family=Signika:wght@500;700&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        if ((stored || preferred) === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <script is:inline>
      (() => {
        const SMOOTH_SCROLL_DURATION = 700;

        function easeInOutCubic(t) {
          return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }

        function animateScroll(startY, endY) {
          const startTime = performance.now();

          function tick(now) {
            const elapsed = Math.min((now - startTime) / SMOOTH_SCROLL_DURATION, 1);
            const eased = easeInOutCubic(elapsed);
            window.scrollTo({ top: startY + (endY - startY) * eased, behavior: 'auto' });

            if (elapsed < 1) {
              requestAnimationFrame(tick);
            }
          }

          requestAnimationFrame(tick);
        }

        function scrollToHash(hash) {
          if (!hash || hash === '#') return;

          const target = document.querySelector(hash);
          if (!target) return;

          const header = document.querySelector('.header');
          const offset = header ? header.offsetHeight + 24 : 80;
          const startY = window.scrollY;
          const targetY = target.getBoundingClientRect().top + startY - offset;
          animateScroll(startY, targetY);
        }

        function scrollToTop() {
          const startY = window.scrollY;
          animateScroll(startY, 0);
        }

        document.addEventListener('click', (event) => {
          const hashLink = event.target.closest('a[href^="#"]');
          if (hashLink) {
            const href = hashLink.getAttribute('href');
            if (!href || href === '#') return;

            const target = document.querySelector(href);
            if (!target) return;

            event.preventDefault();
            history.pushState(null, '', href);
            scrollToHash(href);
          }

          const topButton = event.target.closest('[data-back-to-top]');
          if (topButton) {
            event.preventDefault();
            scrollToTop();
          }
        });

        if (window.location.hash) {
          requestAnimationFrame(() => scrollToHash(window.location.hash));
        }

        const backToTopButton = document.createElement('button');
        backToTopButton.type = 'button';
        backToTopButton.setAttribute('data-back-to-top', 'true');
        backToTopButton.setAttribute('aria-label', 'Back to top');
        backToTopButton.textContent = '↑';
        backToTopButton.style.position = 'fixed';
        backToTopButton.style.left = '1.5rem';
        backToTopButton.style.bottom = '1.5rem';
        backToTopButton.style.zIndex = '50';
        backToTopButton.style.width = '3rem';
        backToTopButton.style.height = '3rem';
        backToTopButton.style.borderRadius = '9999px';
        backToTopButton.style.border = '1px solid rgba(116, 6, 1, 0.16)';
        backToTopButton.style.background = 'rgba(255, 255, 255, 0.9)';
        backToTopButton.style.color = '#740601';
        backToTopButton.style.boxShadow = '0 10px 25px rgba(0, 0, 0, 0.12)';
        backToTopButton.style.fontSize = '1.4rem';
        backToTopButton.style.fontWeight = '700';
        backToTopButton.style.cursor = 'pointer';
        backToTopButton.style.opacity = '0';
        backToTopButton.style.visibility = 'hidden';
        backToTopButton.style.transform = 'translateY(12px)';
        backToTopButton.style.transition = 'opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease';
        document.body.appendChild(backToTopButton);

        function updateBackToTopButton() {
          const shouldShow = window.scrollY > 300;
          backToTopButton.style.opacity = shouldShow ? '1' : '0';
          backToTopButton.style.visibility = shouldShow ? 'visible' : 'hidden';
          backToTopButton.style.transform = shouldShow ? 'translateY(0)' : 'translateY(12px)';
        }

        updateBackToTopButton();
        window.addEventListener('scroll', updateBackToTopButton, { passive: true });
      })();
    </script>
    <Header />
    <main class="grow">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
